<ROSETTASCRIPTS>

		<SCOREFXNS>
                        <ScoreFunction name="ligand_soft_rep" weights="ligand_soft_rep">
				<Reweight scoretype="fa_intra_rep" weight="0.6"/>
                        </ScoreFunction>
                        <ScoreFunction name="hard_rep" weights="ligand">
                                <Reweight scoretype="fa_rep" weight="0.80"/>
                                <Reweight scoretype="fa_elec" weight="0.42"/>
                                <Reweight scoretype="fa_sol" weight="0.65"/>
                                <Reweight scoretype="fa_intra_rep" weight="1.0"/>
                        </ScoreFunction>
		</SCOREFXNS>

		<TASKOPERATIONS>
			<ReadResfile name="rrf" filename="lig.resfile"/>
			<DetectProteinLigandInterface name="pack_interface" cut1="0.0" cut2="0.0" cut3="0.0" cut4="0.0" design="0" />
		</TASKOPERATIONS>

                <LIGAND_AREAS>
                        <LigandArea name="inhibitor_dock_sc" chain="X" cutoff="0.0" add_nbr_radius="false" all_atom_mode="true" minimize_ligand="5" />
                        <LigandArea name="inhibitor_final_sc" chain="X" cutoff="0.0" add_nbr_radius="false" all_atom_mode="true" minimize_ligand="5" />
			<LigandArea name="inhibitor_final_bb" chain="X" cutoff="0.0" add_nbr_radius="false" all_atom_mode="true" minimize_ligand="5" Calpha_restraints="0.3" />
                </LIGAND_AREAS>

                <INTERFACE_BUILDERS>
                        <InterfaceBuilder name="side_chain_for_docking" ligand_areas="inhibitor_dock_sc"/>
                        <InterfaceBuilder name="side_chain_for_final" ligand_areas="inhibitor_final_sc"/>
                        <InterfaceBuilder name="backbone" ligand_areas="inhibitor_final_bb" extension_window="3"/>
                </INTERFACE_BUILDERS>

                <MOVEMAP_BUILDERS>
                        <MoveMapBuilder name="docking" sc_interface="side_chain_for_docking" />
                        <MoveMapBuilder name="final" sc_interface="side_chain_for_final" bb_interface="backbone" />
                </MOVEMAP_BUILDERS>

                <SCORINGGRIDS ligand_chain="X" width="20">
                        <ClassicGrid grid_name="vdw" weight="1.0"/>
                </SCORINGGRIDS>

		<MOVERS>
                        <Transform name="transform" chain="X" box_size="5" move_distance="0.1" angle="5" cycles="500" repeats="1" temperature="5" initial_perturb="0.1" initial_angle_perturb="10" cst_fa_file="constraints.cst" cst_fa_weight="1" use_constraints="true"/>
                        <Transform name="transform_2" chain="X" box_size="5" move_distance="0.1" angle="5" cycles="100" repeats="1" temperature="5" cst_fa_file="constraints.cst" cst_fa_weight="10" use_constraints="true"/>
			<StartFrom name="start" chain="X" use_nbr="1">
$replace$
			</StartFrom>
			<PackRotamersMover name="pack" scorefxn="hard_rep" task_operations="pack_interface" />
                        <HighResDocker name="high_res_docker" cycles="9" repack_every_Nth="3" scorefxn="ligand_soft_rep" movemap_builder="docking" />
                        <ConstraintSetMover name="add_constraints" add_constraints="1" cst_file="constraints.cst" />
                        <FinalMinimizer name="final" scorefxn="hard_rep" movemap_builder="final" remove_constraints="1"/>
                        <ClearConstraintsMover name="clear_constraints" />
                        <InterfaceScoreCalculator name="add_scores" chains="X" scorefxn="hard_rep"/> 
		</MOVERS>

		<PROTOCOLS>
			<Add mover_name="start"/>
			<Add mover_name="pack"/>
			<Add mover_name="transform"/>
                        <Add mover_name="transform_2"/>
                        <Add mover_name="pack"/>
			<Add mover_name="add_constraints"/>
			<Add mover_name="high_res_docker"/>
			<Add mover_name="final"/>
			<Add mover_name="add_scores"/>
		</PROTOCOLS>

</ROSETTASCRIPTS>
